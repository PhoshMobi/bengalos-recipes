# No point in running timer for the package manager
disable apt-daily-upgrade.*
disable apt-daily.*
disable apt-listchanges.timer

# Disable avahi, we have systemd resolved and avahi fails to
# start due to the missing avahi user
disable avahi-daemon.*

# Phosh & GNOME don't have user-space wiring, we need something as
# https://www.volkerkrause.eu/2026/08/15/kde-nfc-integration.html
disable neard.*

# Disable automatic updates as we don't want them to happen on
# e.g. mobile data
disable systemd-sysupdate.*
disable systemd-sysupdate-reboot.*

# Blocks user lookup on first boot
disable systemd-nsresourced.*
